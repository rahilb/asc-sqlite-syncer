# --- App Store Connect API credentials (required) ---
# From Users and Access > Integrations > App Store Connect API.
ASC_KEY_ID=ABC123DEF4
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Path to the downloaded .p8 private key. Alternatively set ASC_PRIVATE_KEY
# to the PEM contents directly (\n-escaped newlines are accepted).
ASC_PRIVATE_KEY_PATH=/secrets/AuthKey_ABC123DEF4.p8

# --- Reporting targets ---
# Vendor number from Payments and Financial Reports (required for sales/subs).
ASC_VENDOR_NUMBER=80000000
# Comma-separated app Apple IDs for the reviews source.
ASC_APP_IDS=1234567890,1234567891

# --- Source toggles (optional, default true) ---
ENABLE_SALES=true
ENABLE_SUBSCRIPTIONS=true
ENABLE_REVIEWS=true

# --- Report versions (optional; Apple's error lists valid values if wrong) ---
SALES_REPORT_VERSION=1_1
SUBSCRIPTION_REPORT_VERSION=1_4

# --- Behaviour (optional) ---
LISTEN_ADDR=:9844
REFRESH_INTERVAL=1h
REPORT_LOOKBACK_DAYS=5
REVIEWS_MAX=1000
HTTP_TIMEOUT=60s
